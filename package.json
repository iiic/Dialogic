{
	"name": "@iiic/dialogic.js",
	"version": "0.2.0",
	"description": "Popups built on the native <dialog> element with the same API as the browser's Notification(), no permission needed, vanilla JavaScript without dependencies",
	"keywords": [
		"dialogic",
		"dialog",
		"notification",
		"notification-api",
		"popup",
		"alert",
		"confirm",
		"custom-element",
		"web-components",
		"front-end",
		"vanilla",
		"vanilla-js",
		"javascript",
		"ecmascript",
		"js",
		"dom",
		"mjs"
	],
	"homepage": "https://iiic.dev/dialogic#npmjs",
	"bugs": {
		"url": "https://github.com/iiic/Dialogic/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iiic/Dialogic.git"
	},
	"license": "CC-BY-SA-4.0",
	"author": "ic <ic.czech+npmjs@gmail.com> (https://iiic.dev/#npmjs)",
	"type": "module",
	"main": "./dialogic.mjs",
	"types": "./dialogic.d.mts",
	"exports": {
		".": {
			"types": "./dialogic.d.mts",
			"default": "./dialogic.mjs"
		},
		"./css/*": "./css/*",
		"./media/*": "./media/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dialogic.mjs",
		"dialogic.d.mts",
		"dialogic.globals.d.ts",
		"modules/string/hashCode.mjs",
		"css/dialogic.css",
		"media/bell.mp3"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test dialogic.spec.mjs",
		"prepublishOnly": "npm test"
	},
	"devDependencies": {
		"console-filter-js": "1.0.0",
		"css.escape": "^1.5.1",
		"jsdom": "^30.0.1"
	}
}
