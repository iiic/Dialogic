{
	"name": "@iiic/dialogic.js",
	"version": "0.2.0",
	"description": "Popups built on the native <dialog> element with the same API as the browser's Notification(), no permission needed, vanilla JavaScript without dependencies",
	"keywords": [
		"dialogic",
		"dialog",
		"notification",
		"notification-api",
		"popup",
		"alert",
		"confirm",
		"custom-element",
		"web-components",
		"front-end",
		"vanilla",
		"vanilla-js",
		"javascript",
		"ecmascript",
		"js",
		"dom",
		"mjs"
	],
	"homepage": "https://iiic.dev/dialogic#npmjs",
	"bugs": {
		"url": "https://github.com/iiic/Dialogic/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iiic/Dialogic.git"
	},
	"license": "CC-BY-SA-4.0",
	"author": "ic <ic.czech+npmjs@gmail.com> (https://iiic.dev/#npmjs)",
	"type": "module",
	"main": "./dialogic.mjs",
	"types": "./dialogic.d.mts",
	"exports": {
		".": {
			"types": "./dialogic.d.mts",
			"default": "./dialogic.mjs"
		},
		"./css/*": "./css/*",
		"./media/*": "./media/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dialogic.mjs",
		"dialogic.d.mts",
		"dialogic.globals.d.ts",
		"modules/string/hashCode.mjs",
		"css/dialogic.css",
		"media/bell.mp3"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test dialogic.spec.mjs",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include=dialogic.mjs --test-coverage-include=\"modules/string/*.mjs\" --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 dialogic.spec.mjs",
		"test:browsers": "node scripts/test-browsers.mjs",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"**/*.css\"",
		"lint:html": "htmlhint \"**/*.html\"",
		"lint:md": "markdownlint-cli2",
		"check": "npm run check:syntax && npm run lint && npm run check:types && npm run check:integrity && npm run check:package && npm run test:coverage",
		"check:syntax": "node scripts/check-syntax.mjs",
		"check:types": "tsc -p tsconfig.types.json",
		"check:integrity": "node scripts/check-integrity.mjs",
		"check:package": "publint && attw --pack . --profile esm-only",
		"prepublishOnly": "npm test"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"console-filter-js": "1.0.0",
		"css.escape": "^1.5.1",
		"eslint": "^10.11.0",
		"globals": "^17.13.0",
		"htmlhint": "^1.9.2",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.3",
		"playwright": "^1.63.0",
		"publint": "^0.3.24",
		"stylelint": "^17.16.0",
		"stylelint-config-recommended": "^18.0.0",
		"typescript": "^7.0.2"
	}
}
